{
  "id": "sharecrm",
  "kind": "channel",
  "channels": ["sharecrm"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "gatewayBaseUrl": { "type": "string" },
      "appId": { "type": "string" },
      "appSecret": { "type": "string" },
