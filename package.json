{
  "name": "@openclaw-fs/sharecrm",
  "version": "1.7.0",
  "description": "ShareCRM IM Gateway channel plugin for OpenClaw",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/scutken/openclaw-sharecrm"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --outfile=dist/sharecrm.js --external:openclaw --external:openclaw/* && esbuild setup-entry.ts --bundle --platform=node --format=esm --outfile=dist/setup-entry.js --external:openclaw --external:openclaw/*",
    "build:package": "npm run build && node ./scripts/build-package.mjs",
    "test": "npm run build && node --test test/**/*.test.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "files": [
    "dist/sharecrm.js",
    "dist/setup-entry.js",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "openclaw": {
    "hooks": {},
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/sharecrm.js"
    ],
    "setupEntry": "./setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "channel": {
      "id": "sharecrm",
      "label": "ShareCRM",
      "selectionLabel": "ShareCRM IM Gateway",
      "blurb": "Connect ShareCRM IM to OpenClaw via SSE gateway.",
      "order": 95
    },
    "install": {
      "localPath": "extensions/sharecrm",
      "defaultChoice": "local"
    }
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "esbuild": "^0.27.3",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.3"
  }
}
