{
  "name": "@openclaw/sharecrm",
  "version": "1.0.0",
  "description": "ShareCRM IM Gateway channel plugin for OpenClaw",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --outfile=dist/sharecrm.js --external:openclaw --external:openclaw/*",
    "build:package": "npm run build && node ./scripts/build-package.mjs"
  },
  "peerDependencies": {
    "openclaw": "^2026.3.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/sharecrm.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./sharecrm.js"
    ],
    "channel": {
      "id": "sharecrm",
      "label": "ShareCRM",
      "selectionLabel": "ShareCRM IM Gateway",
      "docsPath": "/channels/sharecrm",
      "docsLabel": "sharecrm",
      "blurb": "Connect ShareCRM IM to OpenClaw via SSE gateway.",
      "order": 95
    },
    "install": {
      "localPath": "extensions/sharecrm",
      "defaultChoice": "local"
    }
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
