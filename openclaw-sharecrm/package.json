{
  "name": "@openclaw/sharecrm",
  "version": "1.0.0",
  "description": "ShareCRM IM Gateway channel plugin for OpenClaw",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --outfile=dist/sharecrm.js --external:openclaw --external:openclaw/*"
  },
  "dependencies": {
    "eventsource": "^2.0.2",
    "undici": "^7.22.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "openclaw": {
    "extensions": [
      "./sharecrm.js"
    ],
    "channel": {
      "id": "sharecrm",
      "label": "ShareCRM",
      "selectionLabel": "ShareCRM IM Gateway",
      "docsPath": "/channels/sharecrm",
      "docsLabel": "sharecrm",
      "blurb": "Connect ShareCRM IM to OpenClaw via WebSocket gateway.",
      "order": 95
    },
    "install": {
      "localPath": "extensions/sharecrm",
      "defaultChoice": "local"
    }
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
