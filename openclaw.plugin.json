{
  "id": "sharecrm",
  "name": "ShareCRM",
  "description": "ShareCRM IM Gateway channel plugin for OpenClaw (纷享销客企信).",
  "channels": ["sharecrm"],
  "activation": {
    "onStartup": false,
    "onChannels": ["sharecrm"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "sharecrm": {
      "label": "ShareCRM",
      "description": "ShareCRM IM Gateway messaging via 纷享销客企信。",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "gatewayBaseUrl": { "type": "string" },
          "appId": { "type": "string" },
          "appSecret": { "type": "string" },
          "dmPolicy": {
            "type": "string",
            "enum": ["open", "pairing", "allowlist", "disabled"]
          },
          "allowFrom": {
            "type": "array",
            "items": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
          },
          "groupPolicy": {
            "type": "string",
            "enum": ["open", "allowlist", "disabled"]
          },
          "groupAllowFrom": {
            "type": "array",
            "items": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
          },
          "requireMention": { "type": "boolean", "default": true },
          "mentionAliases": {
            "type": "array",
            "items": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
          },
          "chatId": { "type": "string" },
          "historyLimit": { "type": "integer", "minimum": 0 },
          "textChunkLimit": { "type": "integer", "minimum": 1 },
          "ack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "messages": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              }
            }
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "delayMs": { "type": "integer", "minimum": 1000 },
              "intervalMs": { "type": "integer", "minimum": 1000 },
              "maxTimes": { "type": "integer", "minimum": 1 },
              "scheduleMs": { "type": "array", "items": { "type": "integer", "minimum": 1000 } },
              "repeatMs": { "type": "integer", "minimum": 1000 },
              "messages": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              }
            }
          },
          "groupAck": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "messages": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              }
            }
          },
          "groupProgress": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "delayMs": { "type": "integer", "minimum": 1000 },
              "intervalMs": { "type": "integer", "minimum": 1000 },
              "maxTimes": { "type": "integer", "minimum": 1 },
              "scheduleMs": { "type": "array", "items": { "type": "integer", "minimum": 1000 } },
              "repeatMs": { "type": "integer", "minimum": 1000 },
              "messages": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              }
            }
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string" },
                "gatewayBaseUrl": { "type": "string" },
                "appId": { "type": "string" },
                "appSecret": { "type": "string" },
                "dmPolicy": {
                  "type": "string",
                  "enum": ["open", "pairing", "allowlist", "disabled"]
                },
                "allowFrom": {
                  "type": "array",
                  "items": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
                },
                "groupPolicy": {
                  "type": "string",
                  "enum": ["open", "allowlist", "disabled"]
                },
                "groupAllowFrom": {
                  "type": "array",
                  "items": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
                },
                "requireMention": { "type": "boolean", "default": true },
                "mentionAliases": {
                  "type": "array",
                  "items": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
                },
                "historyLimit": { "type": "integer", "minimum": 0 },
                "textChunkLimit": { "type": "integer", "minimum": 1 },
                "ack": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "messages": {
                      "oneOf": [
                        { "type": "string" },
                        { "type": "array", "items": { "type": "string" } }
                      ]
                    }
                  }
                },
                "progress": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "delayMs": { "type": "integer", "minimum": 1000 },
                    "intervalMs": { "type": "integer", "minimum": 1000 },
                    "maxTimes": { "type": "integer", "minimum": 1 },
                    "scheduleMs": { "type": "array", "items": { "type": "integer", "minimum": 1000 } },
                    "repeatMs": { "type": "integer", "minimum": 1000 },
                    "messages": {
                      "oneOf": [
                        { "type": "string" },
                        { "type": "array", "items": { "type": "string" } }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "uiHints": {
        "": {
          "label": "ShareCRM",
          "help": "ShareCRM IM channel provider configuration (纷享销客企信)."
        },
        "dmPolicy": {
          "label": "DM Policy",
          "help": "Direct message access control. Default is pairing. \"open\" is public only when allowFrom includes \"*\"."
        },
        "groupPolicy": {
          "label": "Group Policy",
          "help": "Group chat access control. Default is disabled. \"open\" allows all groups."
        },
        "gatewayBaseUrl": {
          "label": "Gateway Base URL",
          "help": "ShareCRM IM Gateway base URL. Leave default unless you use a private cloud."
        },
        "appId": {
          "label": "App ID",
          "help": "ShareCRM bot application ID."
        },
        "appSecret": {
          "label": "App Secret",
          "help": "ShareCRM bot application secret.",
          "sensitive": true
        },
        "allowFrom": {
          "label": "DM Allow From",
          "help": "Allowed sender user IDs. Use \"*\" only with dmPolicy=open to allow anyone."
        },
        "requireMention": {
          "label": "Require Mention",
          "help": "Require @mention in group chats to trigger the bot. Defaults to true."
        },
        "mentionAliases": {
          "label": "Mention Aliases",
          "help": "Extra group @ names besides bot_full_id, typically the ShareCRM display name such as 小助手."
        },
        "historyLimit": {
          "label": "History Limit",
          "help": "Number of pending group messages to inject as context."
        },
        "textChunkLimit": {
          "label": "Text Chunk Limit",
          "help": "Max characters per outbound message chunk."
        },
        "ack": {
          "label": "Ack",
          "help": "Send a short emoji acknowledgement immediately after a message is accepted. Leave messages empty to use the default pool."
        },
        "progress": {
          "label": "Progress",
          "help": "If the agent has not started a formal reply, send emoji progress updates with elapsed time at 1/3/6 minutes, then every 3 minutes."
        },
        "groupAck": {
          "label": "Group Ack",
          "help": "Override ack behavior for group chats. Defaults to enabled."
        },
        "groupProgress": {
          "label": "Group Progress",
          "help": "Override progress behavior for group chats. Defaults to disabled."
        }
      }
    }
  }
}
